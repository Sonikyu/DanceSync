{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["server.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api-8001",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["server.main:app", "--port", "8001", "--reload"],
      "port": 8001
    },
    {
      "name": "web-8001",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": ["DANCESYNC_API_URL=http://localhost:8001", "npm", "--prefix", "web", "run", "dev", "--", "--port", "5174"],
      "port": 5174
    }
  ]
}
