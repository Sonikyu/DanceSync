# Copy to .env and edit. Everything here is optional.

# Port on the host machine.
DANCESYNC_PORT=8000

# Upload limits in megabytes.
DANCESYNC_MAX_REFERENCE_MB=100
DANCESYNC_MAX_CLIP_MB=500

# Comma-separated origins allowed to call the API from another site. Not
# needed when you use the web app the container serves.
DANCESYNC_CORS_ORIGINS=http://localhost:5173
